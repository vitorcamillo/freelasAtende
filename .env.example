# IA via Codex CLI no container. auth.json deve ser montado em CODEX_HOME, nunca commitado.
IA_PROVIDER=codex
IA_MODEL=openrouter/free
# Camada principal: so o roteador gratuito do OpenRouter (ele mesmo escolhe o
# modelo free). Deixe vazio para nao misturar modelos de outros provedores.
IA_FALLBACK_MODELS=
# Camada secundaria: so entra quando o gratuito esgota a cota diaria (429) ou
# falha com erro retryable (504 etc). Chave e plano proprios.
IA_SECONDARY_BASE_URL=https://api.z.ai/api/coding/paas/v4
IA_SECONDARY_API_KEY=<chave z.ai do plano de coding>
IA_SECONDARY_MODELS=glm-5.3-flash
# Camada terciaria: volta para a base-url/chave principal (OpenRouter) com um
# modelo PAGO barato. So entra quando o free e a z.ai falharem com erro retryable.
IA_TERTIARY_MODELS=qwen/qwen3.7-flash
IA_MAX_RETRIES=1
IA_TIMEOUT=120
IA_AUTH_ALERTA_COOLDOWN_SEGUNDOS=3600
CODEX_HOME=/var/lib/codex
FREELAS_COOKIES_PATH=/app/data/cookies.json
WORKANA_COOKIES_PATH=/app/data/workana-cookies.json
WORKANA_WORKER_SLUG=

# Secrets base64 para Coolify. Nunca commitar valores reais.
# Gerar localmente:
#   base64 -w0 "$CODEX_HOME/auth.json"
#   base64 -w0 data/cookies.json
#   base64 -w0 data/workana-cookies.json
CODEX_AUTH_JSON_B64=
CODEX_AUTH_JSON_B64_1=
CODEX_AUTH_JSON_B64_2=
CODEX_AUTH_JSON_B64_3=
CODEX_AUTH_JSON_B64_4=
CODEX_AUTH_JSON_B64_5=
# Alternativa compactada para Coolify quando muitos secrets grandes estouram o comando SSH.
CODEX_AUTH_JSON_B64_BUNDLE=
FREELAS_COOKIES_JSON_B64=

# 99Freelas - Preencha com suas credenciais
FREELAS_EMAIL=seu@email.com
FREELAS_PASSWORD=sua_senha
FREELAS_URL_BASE=https://www.99freelas.com.br

# Workana - read-only no primeiro rollout
WORKANA_URL_BASE=https://www.workana.com
WORKANA_USER_AGENT=
WORKANA_MAX_PROJETOS=20

# Upwork - cookie-based (read-only + envio de pergunta). Login assistido via Chrome real.
UPWORK_URL_BASE=https://www.upwork.com
UPWORK_COOKIES_PATH=/app/data/upwork-cookies.json
# Secret base64 para Coolify (gerar: base64 -w0 data/upwork-cookies.json).
UPWORK_COOKIES_JSON_B64=
UPWORK_MAX_PROJETOS=20
UPWORK_MESSAGES_CLIENT_ID=20f1626cfa6ce37af2e83cd472294c59
UPWORK_PROPOSALS_CLIENT_ID=1598ce365dbeb5bdea40df51eeb97780
UPWORK_AUTH_URL_BASE=https://auth.upwork.com
# Credenciais so para o login assistido (JavaDriverless). Nunca commitar valores reais.
UPWORK_EMAIL=
UPWORK_PASSWORD=
# Ative apenas quando for rodar o login assistido (abre um Chrome real):
UPWORK_DRIVERLESS_ENABLED=false
# Login em modo headless (sem janela). Recomendado em servidor. Padrao: true.
UPWORK_LOGIN_HEADLESS=true
# Resposta da pergunta de seguranca do Upwork ("Let's make sure it's you").
# Uma resposta unica, ou pares "trecho-da-pergunta=resposta" separados por ';'
# quando houver mais de uma pergunta possivel. Ex.: best friend=Teta;first pet=Rex
UPWORK_SECURITY_ANSWER=

# Freelancer.com - cookie-based (projetos, propostas elegiveis e inbox). Login assistido via Chrome real.
FREELANCER_URL_BASE=https://www.freelancer.com
FREELANCER_COOKIES_PATH=/app/data/freelancer-cookies.json
# Secret base64 para Coolify (gerar: base64 -w0 data/freelancer-cookies.json).
FREELANCER_COOKIES_JSON_B64=
FREELANCER_OAUTH_TOKEN=
FREELANCER_BIDDER_ID=
FREELANCER_PREFERRED=false
FREELANCER_VERIFIED=false
FREELANCER_MAX_PROJETOS=20
FREELANCER_EMAIL=
FREELANCER_PASSWORD=
FREELANCER_DRIVERLESS_ENABLED=false
FREELANCER_LOGIN_HEADLESS=true

# JavaDriverless: destrava profile com lock obsoleto (ex.: apos crash/restart).
# Precisa estar no AMBIENTE do processo (a lib le via getenv, nao pelo .env do app).
# No systemd/docker use Environment=; localmente exporte antes de subir a app.
JAVA_DRIVERLESS_UNLOCK_STALE_PROFILE_LOCKS=true

# Gmail (SOMENTE LEITURA) para captar o codigo OTP do login assistido.
# Deixe em branco para desativar e usar Telegram/arquivo como fonte do codigo.
# Nunca commitar client secret ou refresh token; injete por Secret Manager em producao.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
# Mantenha o envio/rascunho desligados: aqui o Gmail e so leitura de OTP.
GMAIL_ALLOW_SEND=false
GMAIL_ALLOW_DRAFTS=false
GMAIL_ALLOW_LABELS=false

# Telegram - Preencha com as credenciais do bot
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# Sistema
MODO_DEFAULT=LIVRE
AUTO_ATIVO_INICIAL=true
# Todas ativas para leitura/sincronizacao; escrita externa permanece controlada separadamente.
MARKETPLACES_ENABLED=99FREELAS,WORKANA,UPWORK,FREELANCER,FREELANCER_BR

# Freelancer.com.br (marketplace BR) - site Laravel PROPRIO (ProLinker), NAO e o
# mesmo backend do freelancer.com: catalogo e ids sao independentes.
# Login automatico: /login + POST /conecte-se nao tem captcha; o Chrome real
# resolve o desafio do Cloudflare e reexporta os cookies.
FREELANCERBR_URL_BASE=https://www.freelancer.com.br
FREELANCERBR_COOKIES_PATH=/app/data/freelancerbr-cookies.json
FREELANCERBR_MAX_PROJETOS=20
# Credenciais do .com.br (habilitam a renovacao automatica da sessao).
FREELANCERBR_EMAIL=
FREELANCERBR_PASSWORD=
# Secret base64 para Coolify (gerar: base64 -w0 data/freelancerbr-cookies.json).
# ATENCAO: cf_clearance e atrelado ao IP; cookie capturado localmente pode nao
# valer no servidor. Se o .com.br cair no servidor, recapturar de la.
FREELANCERBR_COOKIES_JSON_B64=
POLLING_INTERVAL=20
CATEGORIA_FILTRO=todas
MIN_CONEXOES_RESERVA=0
SCRAPER_MAX_PAGINAS=1
SISTEMA_SESSAO_INVALIDA_COOLDOWN_SEGUNDOS=120
SISTEMA_SESSAO_CACHE_SEGUNDOS=30
SCRAPER_LOGIN_CACHE_MILLIS=8000
REAL_WRITE_ENABLED=false
REAL_WRITE_SIMULATE=false
TELEGRAM_SIMULATE=false

# Banco MySQL existente fora deste compose.
# Se o MySQL estiver na mesma maquina do Docker/Coolify, host.docker.internal
# aponta para o host por causa do extra_hosts em docker-compose.coolify.yml.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://host.docker.internal:3306/freelas_atende?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=freelas
DB_PASSWORD=troque_esta_senha

# Upwork OAuth 2.0 (Settings > API Access). Desde 15/09/2026 a API do mensageiro
# recusa sessao de navegador com HTTP 401; estas tres variaveis sao o caminho suportado.
# Sessoes e login: ver README, secao "Sessoes e login nas plataformas"
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REFRESH_TOKEN=
